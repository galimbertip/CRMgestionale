# Copia in .env e personalizza. Non committare mai il file .env.
SECRET_KEY=cambia-con-una-stringa-lunga-e-casuale
DB_PASSWORD=cambia-anche-questa
DEBUG=false
PORT=8000

# Indirizzi da cui l'app è raggiungibile (separati da virgola)
ALLOWED_HOSTS=localhost,127.0.0.1,crm.tuodominio.it
CSRF_TRUSTED_ORIGINS=https://crm.tuodominio.it
# URL pubblico del portale, usato nei link inviati via email
PUBLIC_BASE_URL=https://crm.tuodominio.it
# Metti false se accedi solo in http (es. solo da rete locale/Tailscale senza HTTPS)
SECURE_COOKIES=true

# Primo amministratore (creato all'avvio se non esiste)
DJANGO_SUPERUSER_USERNAME=paolo
DJANGO_SUPERUSER_EMAIL=galimberti.p@gmail.com
DJANGO_SUPERUSER_PASSWORD=cambia-subito

# Email (es. Gmail con password per app)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GPverse Assistenza <noreply@tuodominio.it>
# Dove arrivano le notifiche di nuovi ticket
SUPPORT_EMAIL=
